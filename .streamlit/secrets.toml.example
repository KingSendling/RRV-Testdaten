# Kopiere diese Datei zu secrets.toml (wird von Git ignoriert) und trage
# ein eigenes Passwort ein. Für die Streamlit-Cloud-Bereitstellung wird das
# Secret stattdessen über die App-Settings auf share.streamlit.io gesetzt
# ("Settings" -> "Secrets"), nicht über diese Datei.

app_password = "hier-eigenes-passwort-eintragen"
